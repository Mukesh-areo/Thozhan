{
  "name": "thozhan",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"web/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:web": "cd web && node test.cjs",
    "build:web": "esbuild web/src/main.ts --bundle --format=iife --target=es2020 --charset=utf8 --outfile=web/app.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2"
  }
}
